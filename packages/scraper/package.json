{
  "name": "@margeo/scraper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@margeo/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "inspect": "tsx --env-file-if-exists=../../.env --conditions=@margeo/source src/cli/inspect.ts",
    "seed:run": "tsx --env-file-if-exists=../../.env --conditions=@margeo/source src/cli/seed-run.ts",
    "seed:verify-volume": "tsx --env-file-if-exists=../../.env --conditions=@margeo/source src/cli/seed-verify-volume.ts",
    "seed:backfill-verify": "tsx --env-file-if-exists=../../.env --conditions=@margeo/source src/cli/seed-backfill-verify.ts"
  },
  "dependencies": {
    "@margeo/db": "workspace:*",
    "@margeo/shared": "workspace:*",
    "ioredis": "^5.11.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "msw": "^2.15.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15"
  }
}
