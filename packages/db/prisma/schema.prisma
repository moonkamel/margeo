// Schéma Margeo Sourcing — tous les montants en centimes entiers (suffixe Cents).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum ModeVente {
  PARTICULIER
  PRO
}

enum Plan {
  FREE
  MONTHLY
  ANNUAL
}

enum Plateforme {
  VINTED
}

enum Etat {
  NEUF_AVEC_ETIQUETTE
  NEUF_SANS_ETIQUETTE
  TRES_BON
  BON
  SATISFAISANT
}

/// Statut d'une analyse : VERT/ORANGE/ROUGE si servie, INSUFFICIENT_DATA sinon.
enum AnalysisStatut {
  VERT
  ORANGE
  ROUGE
  INSUFFICIENT_DATA
}

enum Confidence {
  low
  high
}

enum SoldSource {
  sold_status
  disappeared
}

enum TrackedListingStatut {
  ACTIVE
  SOLD
  DISAPPEARED
  CLOSED
}

/// Miroir des statuts d'abonnement Stripe.
enum SubscriptionStatus {
  incomplete
  incomplete_expired
  trialing
  active
  past_due
  canceled
  unpaid
  paused
}

model User {
  id                             String    @id @default(cuid())
  email                          String    @unique
  tauxHoraireCents               Int       @default(1200)
  seuilMargeCents                Int       @default(500)
  tempsEstimeMinutes             Int       @default(20)
  coutEmballageCents             Int       @default(50)
  modeVente                      ModeVente @default(PARTICULIER)
  /// Distingue la valeur par défaut d'un taux choisi explicitement par l'utilisateur.
  tauxHoraireModifieManuellement Boolean   @default(false)
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @updatedAt

  analyses      Analysis[]
  alerts        Alert[]
  subscription  Subscription?
  magicLinks    MagicLinkToken[]
  refreshTokens RefreshToken[]
}

model MagicLinkToken {
  id        String    @id @default(cuid())
  /// SHA-256 du jeton envoyé par email ; le jeton en clair n'est jamais stocké.
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Refresh tokens à rotation : chaque usage révoque le jeton et en émet un nouveau
/// dans la même famille. La réutilisation d'un jeton révoqué invalide toute la famille.
model RefreshToken {
  id           String    @id @default(cuid())
  tokenHash    String    @unique
  familyId     String
  userId       String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model Analysis {
  id              String         @id @default(cuid())
  userId          String
  url             String
  externalId      String?
  plateforme      Plateforme     @default(VINTED)
  /// Snapshot de l'annonce normalisée au moment de l'analyse.
  listingSnapshot Json
  /// AnalysisResult complet (estimation + détail de marge) tel que servi au client.
  result          Json
  statut          AnalysisStatut
  margeNetteCents Int?
  score           Int?
  confidence      Confidence?
  categorie       String
  marque          String?
  /// false pour INSUFFICIENT_DATA et pour une réanalyse gratuite (même URL < 24 h).
  consommeQuota   Boolean
  createdAt       DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt, categorie, marque])
}

/// État COURANT d'une annonce suivie par le crawler (une ligne par annonce).
/// Seule source de vérité de l'état ; ListingObservation n'est qu'un journal de snapshots.
model TrackedListing {
  id                 String               @id @default(uuid()) @db.Uuid
  plateforme         Plateforme           @default(VINTED)
  externalId         String
  url                String
  categorie          String
  marque             String?
  /// Null pour les catégories sans taille (tech).
  taille             String?
  prixInitialCents   Int
  prixCourantCents   Int
  etat               Etat
  statut             TrackedListingStatut @default(ACTIVE)
  premiereVuAt       DateTime             @db.Timestamptz(3)
  derniereVuAt       DateTime             @db.Timestamptz(3)
  derniereVerifAt    DateTime             @db.Timestamptz(3)
  /// Échecs « introuvable » consécutifs (règle : 2 échecs espacés d'au moins 12 h → DISAPPEARED).
  echecsConsecutifs  Int                  @default(0)
  soldAt             DateTime?            @db.Timestamptz(3)
  soldPrixCents      Int?
  soldSource         SoldSource?
  /// Sous-catégorie Vinted (catalogue feuille) relevée à la première observation, immuable
  /// ensuite (trigger). Permet de filtrer une catégorie parente crawlée sans re-crawl.
  subcategoryId      Int?
  subcategoryLabel   String?
  /// Catalogue PARENT de la recherche qui a découvert l'annonce (ex. 13, 79) : avec la marque
  /// canonique, clé de rattachement à la cellule. Immuable une fois renseigné (trigger).
  catalogIdRecherche Int?

  observations ListingObservation[]
  vente        SoldObservation?

  @@unique([plateforme, externalId])
  @@index([statut, derniereVerifAt])
  @@index([catalogIdRecherche, marque, statut])
}

/// Journal APPEND-ONLY : un snapshot de l'annonce à chaque observation réussie.
/// Aucun champ d'état courant ici (il vit dans TrackedListing). Une observation
/// « introuvable » n'écrit rien ici : elle incrémente TrackedListing.echecsConsecutifs.
model ListingObservation {
  id               String   @id @default(cuid())
  trackedListingId String   @db.Uuid
  titre            String
  etat             Etat
  prixCents        Int
  favoris          Int
  vues             Int
  payload          Json
  observedAt       DateTime @default(now())

  trackedListing TrackedListing @relation(fields: [trackedListingId], references: [id], onDelete: Cascade)

  @@index([trackedListingId, observedAt])
}

/// PROJECTION de TrackedListing, écrite quand son statut passe à SOLD ou DISAPPEARED.
/// Dénormalisée pour les requêtes de stats ; la source de vérité reste TrackedListing.
model SoldObservation {
  id               String     @id @default(cuid())
  trackedListingId String     @unique @db.Uuid
  externalId       String
  plateforme       Plateforme @default(VINTED)
  /// Dernier prix affiché avant la vente (pas le prix négocié réel).
  prixVenteCents   Int
  etat             Etat
  categorie        String
  marque           String?
  taille           String?
  /// Première observation / mise en ligne, si connue — sert au délai de vente.
  listedAt         DateTime?
  soldAt           DateTime
  /// Seul `sold_status` alimente la médiane de prix ; `disappeared` ne sert qu'à la vitesse.
  source           SoldSource
  createdAt        DateTime   @default(now())

  trackedListing TrackedListing @relation(fields: [trackedListingId], references: [id], onDelete: Cascade)

  @@unique([externalId, plateforme])
  @@index([categorie, marque, taille, soldAt])
}

model Alert {
  id                  String    @id @default(cuid())
  userId              String
  query               Json
  seuilMargeCents     Int
  derniereExecutionAt DateTime?
  active              Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([active, derniereExecutionAt])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  stripeCustomerId     String             @unique
  stripeSubscriptionId String?            @unique
  statut               SubscriptionStatus
  plan                 Plan               @default(FREE)
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum SeedRunStatut {
  RUNNING
  COMPLETED
  PARTIAL
  BUDGET_STOPPED
  FAILED
}

/// Une exécution quotidienne du crawler de seed. Le coût est incrémenté APRÈS CHAQUE appel
/// à la source (pas en fin de run) : un crash en cours de route ne fait pas oublier une dépense.
/// Coûts en millièmes de centime d'euro (1 € = 100 000) pour rester en entiers.
model SeedRun {
  id                       String        @id @default(uuid()) @db.Uuid
  campagne                 String
  statut                   SeedRunStatut @default(RUNNING)
  budgetMaxCents           Int
  startedAt                DateTime      @default(now()) @db.Timestamptz(3)
  finishedAt               DateTime?     @db.Timestamptz(3)
  coutSuiviMilliCents      Int           @default(0)
  coutDecouverteMilliCents Int           @default(0)
  resultatsFactures        Int           @default(0)
  annoncesVerifiees        Int           @default(0)
  nouvellesAnnonces        Int           @default(0)
  ventesDetectees          Int           @default(0)
  disparitions             Int           @default(0)
  erreurs                  Int           @default(0)
  /// Journal par cellule et motif d'arrêt éventuel.
  details                  Json?

  @@index([campagne, startedAt])
}

/// Alias de marques (doc 2b, section 7) : texte tel qu'écrit dans l'annonce → marque canonique.
/// Seuls les alias validés sont utilisés par le seed.
model BrandAlias {
  alias          String    @id
  marque         String
  valide         Boolean   @default(false)
  dateValidation DateTime? @db.Timestamptz(3)

  @@index([marque])
}

/// Sous-catégorie Vinted → catalogue parent de recherche, remplie au fil des observations et
/// vérifiée manuellement (J+14). Sert à détecter un élargissement silencieux des recherches.
model SubcategoryToParent {
  subcategoryId Int     @id
  parentId      Int
  libelle       String
  verifie       Boolean @default(false)

  @@index([parentId])
}
