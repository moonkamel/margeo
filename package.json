{
  "name": "margeo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "dev": "turbo run dev",
    "db:generate": "pnpm --filter @margeo/db generate",
    "db:migrate": "pnpm --filter @margeo/db migrate:deploy",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "scraper:inspect": "pnpm --filter @margeo/scraper inspect"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "eslint": "^10.14.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "turbo": "^2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  }
}
