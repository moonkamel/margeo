{
  "name": "@margeo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env --conditions=@margeo/source src/index.ts",
    "build": "tsup src/index.ts --format esm --clean --target node22",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@margeo/db": "workspace:*",
    "@margeo/shared": "workspace:*",
    "fastify": "^5.6.0",
    "ioredis": "^5.8.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.0",
    "tsx": "^4.20.0"
  }
}
